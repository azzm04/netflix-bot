[Unit]
Description=Netflix Device Kicker
After=network.target netflix-bot.service
# Mulai setelah bot Python jalan (opsional, jika bot Python pakai systemd juga)

[Service]
Type=simple
User=root
WorkingDirectory=/root/netflix-bot/device-kicker

# Gunakan node langsung (bukan npm start agar log lebih bersih)
ExecStart=/usr/bin/node /root/netflix-bot/device-kicker/index.js
Restart=on-failure
RestartSec=30

# Environment
Environment=NODE_ENV=production

# Log output ke systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=netflix-kicker

# Timeout sebelum force kill
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
