# ─── Google Sheets ────────────────────────────────────────
GOOGLE_CREDENTIALS_PATH=../credentials.json
SPREADSHEET_NAME=netflix account jaeminies
SHEETS_TO_CHECK=HARIAN,MINGGUAN,BULANAN
COL_EMAIL=0
COL_PASSWORD=1
COL_PROFILE=2
COL_DEVICE=6
DATA_START_ROW=2

# ─── Scheduler (2x sehari) ────────────────────────────────
# Jam 08:00 dan 20:00 WIB
GUARD_SCHEDULE=0 8,20 * * *

# ─── Browser ──────────────────────────────────────────────
HEADLESS=true

# ─── Cookie file (sama dengan cookie-kicker-pin-changer) ──
COOKIE_FILE=../cookie-kicker-pin-changer/cookies.json

# ─── Telegram ─────────────────────────────────────────────
BOT_TOKEN=
ADMIN_ID=

# ─── Mahesh Bot (untuk MFA akun MEET) ─────────────────────
MAHESH_API_ID=
MAHESH_API_HASH=
MAHESH_PHONE=
MAHESH_SESSION_FILE=../cookie-kicker-pin-changer/mahesh.session
MAHESH_BOT_USERNAME=Maheshshoppiebot
MAHESH_TIMEOUT=30000
